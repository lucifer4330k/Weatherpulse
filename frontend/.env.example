# Frontend Environment Variables
# Copy this file to .env and adjust values as needed

# API base URL (used by frontend to call backend)
# In development, Vite proxies /api to http://127.0.0.1:8000
# In production (Docker), use relative path /api which is proxied by Nginx to backend:8000
VITE_API_URL=/api

# MapTiler API key for satellite/hybrid map styles
# Get a free key at https://cloud.maptiler.com/account/keys
VITE_MAPTILER_API_KEY=demo